GEMINI_API_KEY=...

# Optional — Gmail SMTP for real email delivery from the Share dialog.
# Without these, the "Approve and send" button stays in dummy mode (no real send).
#
# Setup steps for Gmail:
#   1. Enable 2-Factor Authentication on your Google account
#   2. Visit https://myaccount.google.com/apppasswords
#   3. Generate an app password for "Mail" → 16-char string
#   4. Paste it below as SMTP_PASSWORD (NOT your normal Gmail password)
#
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_FROM=your-address@gmail.com    # optional, defaults to SMTP_USER
# SMTP_HOST=smtp.gmail.com            # optional, default
# SMTP_PORT=587                       # optional, 587 = STARTTLS / 465 = SSL
